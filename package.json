{
  "name": "@lvce-editor/text-search-view-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "npm exec --workspace=packages/build -- esbuild --format=esm --bundle --external:node:buffer --external:electron --external:ws --external:node:worker_threads --watch packages/text-search-view/src/textSearchViewMain.ts --outfile=.tmp/dist/dist/textSearchViewMain.js",
    "dev": "node packages/build/src/dev.ts",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "measure": "npm run measure --workspace=packages/build",
    "test": "npm test --workspaces --if-present",
    "test-integration": "npm run test-integration --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.9.0",
    "eslint": "^10.9.1",
    "knip": "^6.34.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3"
  }
}
